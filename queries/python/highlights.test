%language Python

# A name takes the most specific colour that fits it: the one after `def`
# is a function and the one after `class` a type, though every name is
# also an identifier
> class Greeter:
  ^^^^^ keyword
        ^^^^^^^ type
>     def greet(self, name):
      ^^^ keyword
          ^^^^^ function
                ^^^^ variable.builtin
                      ^^^^ variable.parameter

# All capitals is a constant, digits and one letter too
> count = MAX_SIZE + HTTP2 + X
  ^^^^^ variable
          ^^^^^^^^ constant
                     ^^^^^ constant
                             ^ constant

# A capital first is a class, named or called: a call to it makes one
> MAX = Greeter
  ^^^ constant
        ^^^^^^^ type
> isinstance(x, Greeter)
  ^^^^^^^^^^ function.builtin
             ^ variable
                ^^^^^^^ type
> class Greeter(Base):
                ^^^^ type
> Greeter()
  ^^^^^^^ type

# The look of a name holds after a dot too: a field can be a class or a
# constant
> d = collections.OrderedDict(); n = self.MAX
      ^^^^^^^^^^^ variable
                  ^^^^^^^^^^^ type
                                          ^^^ constant

# Any other call is a call
> greet(x)
  ^^^^^ function.call

# Parameters where they are declared, their types, the return type
>     def __init__(self, name: str, n: int = 0) -> None:
      ^^^ keyword
          ^^^^^^^^ function
                   ^^^^ variable.builtin
                         ^^^^ variable.parameter
                               ^^^ type
                                    ^ variable.parameter
                                       ^^^ type
                                             ^ number
                                                ^^ operator
                                                   ^^^^ constant.builtin
> def f(xs: list[int]) -> dict[str, int]:
            ^^^^ type
                 ^^^ type
                          ^^^^ type
> def g(*args, **kwargs): return lambda y: y
         ^^^^ variable.parameter
                 ^^^^^^ variable.parameter
                                        ^ variable.parameter
                                           ^ variable

# `self` and `cls` are known by their text, wherever they stand; a field
# is a property, a method called on it a method
> self.name = cls.make()
  ^^^^ variable.builtin
       ^^^^ property
              ^^^ variable.builtin
                  ^^^^ function.method.call
>         super().__init__()
          ^^^^^ function.builtin
                  ^^^^^^^^ function.method.call

# A decorator is an attribute, its `@` too, and of a name reached through
# another or called, the last name
> @property
  ^ attribute
   ^^^^^^^^ attribute
> @app.route("/")
  ^ attribute
   ^^^ variable
       ^^^^^ attribute
> @functools.cache
             ^^^^^ attribute
> @wraps(f)
   ^^^^^ attribute

# A builtin is told from any other call
> return len("hi")  # polite
         ^^^ function.builtin
             ^^^^ string
                    ^^^^^^^^ comment
> with open(p) as fh: pass
  ^^^^ keyword
       ^^^^ function.builtin
                      ^^^^ keyword

# Strings of every kind; in an f-string the code is code
> print(f"hi {name}!\n")
  ^^^^^ function.builtin
        ^^^^^ string
             ^ punctuation.special
              ^^^^ variable
                  ^ punctuation.special
                    ^^ escape
> data = b"raw" + r"\d"
         ^^^^^^ string
                  ^^^^^ string

# A docstring is documentation, not just a string
> def h():
  ^^^ keyword
>     """Says what h does."""
      ^^^ string.documentation

# Numbers, and the language's own constants
> x = (1, 2.5, 0x1F, True, False, None, ...)
       ^ number
          ^^^ number
               ^^^^ number
                     ^^^^ constant.builtin
                           ^^^^^ constant.builtin
                                  ^^^^ constant.builtin
                                        ^^^ constant.builtin

# Operators spelt as words are keywords, like `if`
> if not name:
  ^^ keyword
     ^^^ keyword
> for x in xs:
        ^^ keyword
> while a is not b and c not in d: break
  ^^^^^ keyword
          ^^^^^^ keyword
                   ^^^ keyword
                         ^^^^^^ keyword
                                   ^^^^^ keyword

# A module is a module where an import names it, every part of a dotted
# name, an alias and a relative path too, whatever its case
> import os.path, PIL
         ^^ module
            ^^^^ module
                  ^^^ module
> import numpy as np
         ^^^^^ module
                  ^^ module
> from ..config import Config
         ^^^^^^ module
                       ^^^^^^ type

# Used later, it is a name like any other
> os.getcwd()
  ^^ variable
     ^^^^^^ function.method.call

# Where a type stands a name is a type, whatever its look: a type
# parameter is not a constant
> def first[T](xs: list[T]) -> T:
      ^^^^^ function
            ^ type
                   ^^^^ type
                        ^ type
                               ^ type
>     return xs[0]

# The types listed in an annotation are types too
> cb: Callable[[int, str], None]
      ^^^^^^^^ type
                ^^^ type
                     ^^^ type
                           ^^^^ constant.builtin

# Outside an annotation only its look tells
> T = TypeVar("T")
  ^ constant
      ^^^^^^^ type

# The names every module has are the language's
> if __name__ == "__main__":
     ^^^^^^^^ variable.builtin
                 ^^^^^^^^^^ string
>     print(__file__)
      ^^^^^ function.builtin
            ^^^^^^^^ variable.builtin

# A name declared is what it declares, whatever its look; used, its look
# decides
> def Factory(): pass
      ^^^^^^^ function
> class HTTP: pass
        ^^^^ type
> x = Factory() + HTTP.code
      ^^^^^^^ type
                  ^^^^ constant

# Operators spelt as signs
> y = a @ b; y @= c; z := 1
        ^ operator
               ^^ operator

# Imports and exceptions
> from os import path as p
  ^^^^ keyword
       ^^ module
          ^^^^^^ keyword
                 ^^^^ variable
                      ^^ keyword
> try:
  ^^^ keyword
>     raise ValueError("no")
      ^^^^^ keyword
            ^^^^^^^^^^ type
> except (KeyError, OSError) as e:
  ^^^^^^ keyword
          ^^^^^^^^ type
                    ^^^^^^^ type

# The rest of the keywords
> async def g():
  ^^^^^ keyword
>     await h(); yield x; return lambda y: y
      ^^^^^ keyword
                 ^^^^^ keyword
                          ^^^^^^ keyword
                                 ^^^^^^ keyword
> global g; nonlocal n; del x; assert y
  ^^^^^^ keyword
            ^^^^^^^^ keyword
                        ^^^ keyword
                               ^^^^^^ keyword
> type Point = tuple[int, int]
  ^^^^ keyword
       ^^^^^ type
