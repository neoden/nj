%language Rust

# Keywords, a function's name, a string; a local's name is plain
> fn main() {
  ^^ keyword
     ^^^^ function
>     let s = "hi";
      ^^^ keyword
          ^ -
              ^^^^ string
> }

# All capitals is a constant, one letter as well
> const MAX_SIZE: u8 = 1;
  ^^^^^ keyword
        ^^^^^^^^ constant
                  ^^ type.builtin
> const N: usize = 2;
        ^ constant
> static mut COUNT: u32 = 0;
  ^^^^^^ keyword
             ^^^^^ constant

# Numbers are numbers, `true` and `false` the language's own constants
> let x = (42, 1.5, true);
           ^^ number
               ^^^ number
                    ^^^^ constant.builtin

# A type is a type where it stands, in a path too
> let v: Vec<String> = Vec::new();
  ^^^ keyword
         ^^^ type
            ^ punctuation.bracket
             ^^^^^^ type
                       ^^^ type
                          ^^ punctuation.delimiter
                            ^^^ function
> impl Point { fn new() -> Self { Self { x: 1 } } }
  ^^^^ keyword
       ^^^^^ type
                           ^^^^ type
                                  ^^^^ type
                                         ^ property
> unsafe impl<T> Send for W<T> where T: Copy {}
  ^^^^^^ keyword
             ^ punctuation.bracket
              ^ type
                               ^^^^^ keyword

# A capital first is a constructor: an enum's variant, in a pattern too
> let x = Some(Foo);
          ^^^^ constructor
               ^^^ constructor
> match o { Some(v) => v, None => 0 }
  ^^^^^ keyword
            ^^^^ constructor
                          ^^^^ constructor
> if let Shape::Circle { r } = s {}
         ^^^^^ type
                ^^^^^^ constructor

# A field is a property, a method called on it a method
> let n = p.x + p.len();
            ^ property
           ^ punctuation.delimiter
                  ^^^ function.method

# Calls by name, by path and with generics
> Foo::bar();
  ^^^ type
       ^^^ function
> std::mem::swap(a, b);
  ^^^ module
       ^^^ module
            ^^^^ function

# A name a path goes through is a module, in a `use` too; the last one
# can be anything, and a capital makes a type
> use std::collections::{HashMap, HashSet};
      ^^^ module
           ^^^^^^^^^^^ module
> use std::io::*;
      ^^^ module
           ^^ module
> mod config;
      ^^^^^^ module
> let c: config::Config = config::load();
         ^^^^^^ module
                 ^^^^^^ type
                          ^^^^^^ module
                                  ^^^^ function
> let m = u8::MAX;
          ^^ type.builtin
> let x = parse::<u8>(s);
          ^^^^^ function
                  ^^ type.builtin
> let y = s.parse::<u8>();
            ^^^^^ function.method
> let f = move |r: &dyn Any| ref_it(r);
          ^^^^ keyword
                    ^^^ keyword
                        ^^^ type
                             ^^^^^^ function

# A parameter where it is declared; where it is used it is a plain name
> fn move_by(&mut self, dx: i32) { self.x += dx; }
             ^ operator
              ^^^ keyword
                  ^^^^ variable.builtin
                        ^^ variable.parameter
                            ^^^ type.builtin
                                   ^^^^ variable.builtin
                                             ^^ -

# A path through `self`, `super` or `crate` is keywords
> use crate::a::{self, b};
  ^^^ keyword
      ^^^^^ keyword
                 ^^^^ keyword
                       ^ -
> use super::c;
      ^^^^^ keyword

# A macro defined: its name a macro, its metavariables parameters, their
# fragments the kind of thing each takes
> macro_rules! square { ($x:expr) => { $x * $x }; }
  ^^^^^^^^^^^^ keyword
               ^^^^^^ function.macro
                         ^^ variable.parameter
                            ^^^^ type
                                       ^^ variable.parameter
                                            ^^ variable.parameter

# A macro called in another's arguments is a macro too; a `!=` there and
# a `!` before a name are not calls
> assert!(matches!(x, Some(_)) && a != b && !done);
  ^^^^^^^ function.macro
          ^^^^^^^^ function.macro
                                  ^ -
                                    ^^ -
                                            ^^^^^ -

# `!` is a type where a function never returns
> fn exit() -> ! { loop {} }
               ^ type.builtin

# A macro is named with its `!`, the string inside it as a string
# The string is a token inside the macro's, and the inner one wins.
> println!("x");
  ^^^^^^^^ function.macro
           ^^^ string
> let v = vec![1, 2];
          ^^^^ function.macro
               ^ number
> macro_rules! twice { () => {} }
  ^^^^^^^^^^^^ keyword
               ^^^^^ function.macro

# Comments, a doc comment told from a plain one
> // plain
  ^^ comment
> /// documented
  ^^^ comment.documentation
> /* block */
  ^^ comment

# An attribute's insides are code: brackets, a trait's name a type
> #[derive(Debug)]
  ^ attribute
   ^ punctuation.bracket
    ^^^^^^ attribute
          ^ punctuation.bracket
           ^^^^^ type
> #[cfg_attr(test, derive(Clone))]
                          ^^^^^ type

# A lifetime is a parameter, next to the types, its quote and all
> fn f<'a>(x: &'a str) {}
       ^^ type.lifetime
               ^^ type.lifetime
                  ^^^ type.builtin

# A label names a loop to break out of, its quote and all
> 'outer: loop { break 'outer; }
  ^^^^^^ label
          ^^^^ keyword
                 ^^^^^ keyword
                       ^^^^^^ label

# Strings of every kind, an escape inside one
> let s = ("a\n", 'c', r"raw");
           ^^ string
             ^^ escape
                  ^^^ string
                       ^^^^^^ string

# The rest of the keywords
> pub struct S; pub enum E {} pub trait T {} type A = B;
  ^^^ keyword
      ^^^^^^ keyword
                    ^^^^ keyword
                                  ^^^^^ keyword
                                             ^^^^ keyword
> async fn g() -> u8 { h().await as u8 }
  ^^^^^ keyword
                           ^^^^^ keyword
                                 ^^ keyword
> for x in xs { while ok { continue } }
  ^^^ keyword
        ^^ keyword
                ^^^^^ keyword
                           ^^^^^^^^ keyword
