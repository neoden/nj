%language SQL

# Comments of both kinds
> -- a line comment
  ^^^^^^^^^^^^^^^^^ comment
> /* a block */ SELECT 1;
  ^^^^^^^^^^^^^ comment

# Keywords in either case; a table is a type, a function a function, a
# column plain, and so is an alias and what stands before a column
> SELECT u.id, SUM(o.total) AS spent FROM users u JOIN orders o ON o.user_id = u.id;
  ^^^^^^ keyword
         ^ variable
               ^^^ function.call
                            ^^ keyword
                                     ^^^^ keyword
                                          ^^^^^ type
                                                  ^^^^ keyword
                                                       ^^^^^^ type
                                                                ^^ keyword.operator
> select count(*) from users where id = 1;
  ^^^^^^ keyword
         ^^^^^ function.call
                  ^^^^ keyword
                             ^^^^^ keyword

# Numbers, whole and not; strings; the language's own values
> SELECT 42, 100.5, 'gold', NULL, TRUE, FALSE;
         ^^ number
             ^^^^^ number
                    ^^^^^^ string
                            ^^^^ constant.builtin
                                  ^^^^ constant.builtin
                                        ^^^^^ constant.builtin

# A condition: CASE and its words, IS NULL, LIKE, IN, BETWEEN
> SELECT CASE WHEN x > 1 THEN 'a' ELSE 'b' END FROM t WHERE y IS NULL AND z LIKE 'a%' AND n IN (1, 2) AND m BETWEEN 1 AND 9;
         ^^^^ keyword
              ^^^^ keyword
                         ^^^^ keyword
                                  ^^^^ keyword
                                           ^^^ keyword
                                                              ^^ keyword
                                                                            ^^^^ keyword
                                                                                            ^^ keyword.operator
                                                                                                            ^^^^^^^ keyword

# A table created: its columns' types builtins, its constraints keywords
> CREATE TABLE IF NOT EXISTS users (
  ^^^^^^ keyword
         ^^^^^ keyword
                             ^^^^^ type
>   id BIGSERIAL PRIMARY KEY,
       ^^^^^^^^^ type.builtin
                 ^^^^^^^ keyword
>   name VARCHAR(100) NOT NULL,
         ^^^^^^^ type.builtin
                 ^^^ number
                          ^^^^ constant.builtin
>   email TEXT UNIQUE,
          ^^^^ type.builtin
               ^^^^^^ keyword
>   created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
               ^^^^^^^^^^^ type.builtin
                           ^^^^^^^ attribute
                                   ^^^^^^^^^^^^^^^^^ attribute
> );

# Changing rows; a cast both ways
> INSERT INTO users (name) VALUES ('Ann') RETURNING id;
  ^^^^^^ keyword
         ^^^^ keyword
                           ^^^^^^ keyword
                                          ^^^^^^^^^ keyword
> UPDATE users SET active = FALSE WHERE id = 1;
  ^^^^^^ keyword
               ^^^ keyword
> SELECT count(*)::int, cast(age as integer) FROM users;
                   ^^^ type.builtin
                        ^^^^ function.call
                                    ^^^^^^^ type.builtin

# A window
> SELECT ROW_NUMBER() OVER (PARTITION BY c ORDER BY s DESC) FROM t;
         ^^^^^^^^^^ function.call
                      ^^^^ keyword
                            ^^^^^^^^^ keyword
                                                      ^^^^ attribute

# Numbers with an exponent; a string of digits is a string
> SELECT 1e10, 2.5e-3, .5, '42';
         ^^^^ number
               ^^^^^^ number
                       ^^ number
                           ^^^^ string

# A function where it is created, its body parsed; the function a trigger
# runs; the trigger itself and its table are objects
> CREATE OR REPLACE FUNCTION add(a integer) RETURNS integer AS $$ BEGIN RETURN a; END; $$ LANGUAGE plpgsql;
                    ^^^^^^^^ keyword
                             ^^^ function
                                            ^^^^^^^ keyword
                                                                  ^^^^^ keyword
                                                                        ^^^^^^ keyword
                                                                                          ^^^^^^^^ keyword
> CREATE TRIGGER trg BEFORE INSERT ON t FOR EACH ROW EXECUTE FUNCTION f();
         ^^^^^^^ keyword
                 ^^^ type
                     ^^^^^^ keyword
                                                                      ^ function.call
> CREATE TRIGGER trg2 AFTER UPDATE ON t FOR EACH ROW EXECUTE PROCEDURE p();
                                                                       ^ function.call

# Upserts of two dialects, a MERGE, a recursive CTE
> INSERT INTO t (id) VALUES (1) ON DUPLICATE KEY UPDATE id = id + 1;
                                   ^^^^^^^^^ keyword
> MERGE INTO t USING s ON t.id = s.id WHEN MATCHED THEN UPDATE SET n = s.n;
  ^^^^^ keyword
                                           ^^^^^^^ keyword
> WITH RECURSIVE tree AS (SELECT 1) SELECT * FROM tree;
       ^^^^^^^^^ keyword

# Postgres's operators and literals; a comment inside an expression
> SELECT meta ->> 'b', ARRAY[1, 2], id::text[], 1 /* c */ + 2, E'a\n', $tag$raw$tag$;
                       ^^^^^ function.call
                                        ^^^^ type.builtin
                                                  ^^^^^^^ comment
                                                               ^^^^^^ string
                                                                       ^^^^^^^^^^^^^ string

# A window's frame, a filter on an aggregate
> SELECT sum(x) OVER (ORDER BY d ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), count(*) FILTER (WHERE ok) FROM t;
                                 ^^^^ keyword
                                              ^^^^^^^^^ keyword
                                                        ^^^^^^^^^ attribute
                                                                                             ^^^^^^ keyword
