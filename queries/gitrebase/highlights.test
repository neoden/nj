%language Git rebase

# A command on a commit is a keyword, the commit a builtin, its subject a
# comment, which has no effect on the rebase
> pick a1b2c3d Fix the parser
  ^^^^ keyword
       ^^^^^^^ constant.builtin
               ^^^^^^^^^^^^^^ comment
> s 8b9c0d1 fixup! Add tests
  ^ keyword
    ^^^^^^^ constant.builtin
            ^^^^^^^^^^^^^^^^ comment

# A fixup is an attribute, with `-C` too, and its subject a comment
> fixup 2e3f4a5 Tidy up
  ^^^^^ attribute
                ^^^^^^^ comment
> fixup -C 2e3f4a5 Tidy up
  ^^^^^ attribute
           ^^^^^^^ constant.builtin
                   ^^^^ comment
                        ^^ comment

# A label is made and used; a merge names a commit, a label and its
# message
> label onto
  ^^^^^ function
        ^^^^ constant
> merge -C 1a2b3c4 onto # Merge branch
  ^^^^^ keyword
           ^^^^^^^ constant.builtin
                   ^^^^ constant
                        ^^^^^^^^^^^^^^ string

# What `exec` runs is Shell
> exec cargo test --all
  ^^^^ keyword
       ^^^^^ function.call
                  ^^^^^ constant
> x echo "done"
  ^ keyword
    ^^^^ function.builtin
         ^^^^^^ string

# git's comments
> # Rebase 1a2b3c4..6b7c8d9 onto 1a2b3c4 (8 commands)
  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment

# The short forms of the commands; a full hash; git 2.55 writes the
# subject after a `#`
> p 0e0be44 # short pick
  ^ keyword
    ^^^^^^^ constant.builtin
            ^^^^^^^^^^^^ comment
> d 5e6f7a8 # drop
  ^ keyword
> pick 0e0be4400000000000000000000000000000000 # full hash
       ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ constant.builtin

# A label made and reset to; a break; what `exec` runs, with a pipe
> l onto
  ^ function
    ^^^^ constant
> t onto
  ^ function
> b
  ^ keyword
> x make test | tee log.txt && echo "done ok"
  ^ keyword
    ^^^^ function.call
                ^^^ function.call
                               ^^^^ function.builtin
                                    ^^^^^^^^^ string

# A ref moved where the rebase has got, in both forms; a list of nothing
> u refs/heads/topic
  ^ keyword
    ^^^^^^^^^^^^^^^^ constant
> update-ref refs/heads/other
  ^^^^^^^^^^ keyword
             ^^^^^^^^^^^^^^^^ constant
> noop
  ^^^^ keyword
