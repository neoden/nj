%language Shell

# An environment file is Shell: a key a variable, `export` a keyword, a
# quoted value a string, a reference a variable in it
> DATABASE_URL=postgres://user:pass@localhost:5432/db
  ^^^^^^^^^^^^ variable
> export API_KEY="abc123"
  ^^^^^^ keyword
         ^^^^^^^ variable
                 ^^^^^^^^ string
> GREETING='hello world'
           ^^^^^^^^^^^^^ string
> PATH_EXTRA="${HOME}/bin:$PATH"
              ^^^^^^ variable
                          ^^^^^ variable
> # a comment
  ^^^^^^^^^^^ comment
