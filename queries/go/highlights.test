%language Go

# A function is a function where it is declared and a call where it is
# called, though its name is also an identifier
> func greet(name string) string {
  ^^^^ keyword
       ^^^^^ function
             ^^^^ variable
                  ^^^^^^ type
>     return format(name)
      ^^^^^^ keyword
             ^^^^^^ function.call
                    ^^^^ variable

# A method too, declared on a receiver and called through a dot, though
# its name is also a field
> func (g *Greeter) Greet() {}
        ^ variable
           ^^^^^^^ type
                    ^^^^^ function.method
> g.Greet()
  ^ variable
    ^^^^^ function.method.call

# A method an interface asks for is a method, not a field
> type Reader interface { Read(p []byte) (n int, err error) }
                          ^^^^ function.method

# A type parameter is a type where it is declared and where it is used
> func Map[T any](xs []T) T { return xs[0] }
           ^ type
             ^^^ type
                       ^ type
                          ^ type

# A constant is a constant where it is declared, whatever its look; used
# later, only its look tells
> const MaxSize = 10
        ^^^^^^^ constant
> const (
>     A = iota
      ^ constant
          ^^^^ constant.builtin
>     b
      ^ constant
> )
> n := MaxSize
       ^^^^^^^ variable

# A key in a composite literal is a field, its value a value
> a := App{cfg: c, n: 1}
       ^^^ type
           ^^^ property
                ^ variable
                   ^ property

# A label where it stands and where `break` and `goto` name it
> func f() {
> outer:
  ^^^^^ label
>     for { break outer }
                  ^^^^^ label
>     goto outer
           ^^^^^ label
> }

# The builtins of Go 1.21 are builtins
> m := min(a, b) + max(a, b); clear(xs)
       ^^^ function.builtin
                   ^^^ function.builtin
                              ^^^^^ function.builtin

# A conversion to a predeclared type is the type; to one's own, a call
> n := int64(x) + float64(y) + Celsius(z)
       ^^^^^ type
                  ^^^^^^^ type
                               ^^^^^^^ function.call

# A field read is a property, not a call
> n := g.count
  ^ variable
         ^^^^^ property

# The functions the language provides are builtins; any other is not
> n := len(xs) + lenient(xs)
       ^^^ function.builtin
                 ^^^^^^^ function.call

# A package is a module in a type, its clause and an import's alias; in
# an expression it is a name like any other
> package main
  ^^^^^^^ keyword
          ^^^^ module
> import cfg "app/config"
         ^^^ module
             ^^^^^^^^^^^^ string
> var c *config.Config = config.Load()
         ^^^^^^ module
                ^^^^^^ type
                         ^^^^^^ variable
                                ^^^^ function.method.call

# Literals of every kind, and the constants of the language
> var s, r, c = "a\tb", `raw\n`, 'x'
                ^^ string
                  ^^ escape
                    ^^ string
                        ^^^^^^^ string
                                 ^^^ string
> x := []any{1, 2.5, 3i, true, nil, iota}
             ^ number
                ^^^ number
                     ^^ number
                         ^^^^ constant.builtin
                               ^^^ constant.builtin
                                    ^^^^ constant.builtin

# Comments of both kinds
> x := 1 // why
         ^^^^^^ comment
> /* block */
  ^^^^^^^^^^^ comment
