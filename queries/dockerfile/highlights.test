%language Dockerfile

# A parser directive is a comment; instructions are keywords, in either
# case; a variable the build reads is a constant with its `$` and braces
> # syntax=docker/dockerfile:1
  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment
> ARG VERSION=3.12
  ^^^ keyword
> FROM python:${VERSION}-slim AS build
  ^^^^ keyword
              ^^^^^^^^^^ constant
                              ^^ keyword
> from alpine as small
  ^^^^ keyword
              ^^ keyword
> WORKDIR $APP_HOME
  ^^^^^^^ keyword
          ^^^^^^^^^ constant

# A string, with a variable in it
> ENV PATH="/app/bin:$PATH"
  ^^^ keyword
           ^^^^^^^^^^ string
                     ^^^^^ constant

# A RUN is Shell, over lines joined by `\` too
> RUN apt-get update && apt-get install -y curl \
  ^^^ keyword
      ^^^^^^^ function
                                        ^^ constant
>     && rm -rf /var/lib/apt/lists/*
         ^^ function
            ^^^ constant
> RUN --mount=type=cache,target=/root/.cache pip install -r requirements.txt
                                             ^^^ function

# A RUN's heredoc is Shell, its markers labels
> RUN <<EOF
      ^^^^^ label
> echo "hello"
  ^^^^ function.builtin
       ^^^^^^^ string
> EOF
  ^^^ label

# A COPY's heredoc is the language of the file it writes
> COPY <<EOF /etc/app/config.json
  ^^^^ keyword
> {"debug": true, "port": 8080}
   ^^^^^^^ string.special.key
            ^^^^ constant.builtin
                          ^^^^ number
> EOF

# A port is a number; the JSON form of a command is strings
> EXPOSE 8080/tcp
         ^^^^^^^^ number
> ENTRYPOINT ["python", "-m", "app"]
  ^^^^^^^^^^ keyword
              ^^^^^^^^ string
> HEALTHCHECK --interval=30s CMD curl -f http://localhost/ || exit 1
  ^^^^^^^^^^^ keyword
                             ^^^ keyword
                                 ^^^^ function
                                                              ^^^^ keyword

# Lines joined by `\`, a comment between them, in an ENV and a RUN; a
# variable with a default is one token, its operator the operator's
> ENV A=1 \
  ^^^ keyword
>     B="two words" \
        ^^^^^^^^^^^ string
>     C=${A:-fallback}
        ^^^ constant
             ^^^^^^^^^ constant
> RUN set -eux; \
      ^^^ function.builtin
          ^^^^ constant
>     # a comment inside the continuation
      ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment
>     apt-get update
      ^^^^^^^ function

# Heredocs: a dash before the marker, two in one RUN, a quoted marker;
# the program named after the marker is Shell's command
> RUN <<-EOT bash
      ^^^^^^ label
             ^^^^ function
> echo indented
  ^^^^ function.builtin
> EOT
  ^^^ label
> RUN <<A <<B
      ^^^ label
          ^^^ label
> echo first
  ^^^^ function.builtin
> A
> echo second
> B
> COPY <<"EOF" /app/settings.yaml
       ^^^^^^^ label
> debug: true
         ^^^^ constant.builtin
> EOF

# A platform and a digest, the flags of RUN, COPY and ADD
> FROM --platform=$BUILDPLATFORM golang:1.22@sha256:abc123 AS build
                  ^^^^^^^^^^^^^^ constant
                                                           ^^ keyword
> RUN --mount=type=secret,id=npmrc --network=none npm ci
                                                  ^^^ function
> COPY --link --chmod=755 --from=build /out/app /usr/local/bin/
  ^^^^ keyword

# Instructions about other instructions
> ONBUILD RUN make
  ^^^^^^^ keyword
          ^^^ keyword
              ^^^^ function
> HEALTHCHECK NONE
              ^^^^ keyword
> SHELL ["/bin/bash", "-o", "pipefail", "-c"]
  ^^^^^ keyword
         ^^^^^^^^^^^ string
> ENTRYPOINT exec app --flag
             ^^^^ function.builtin
                      ^^^^^^ constant
