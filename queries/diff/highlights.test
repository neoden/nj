%language Diff

# A diff from git: the line that starts it a keyword, the commits
# constants, each file's name its side's, a hunk's head an attribute; a
# line added green and one taken away red, whole; the context plain
> diff --git a/src/main.rs b/src/main.rs
  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ keyword
> index 3b18e51..a1c2d3f 100644
  ^^^^^ keyword
        ^^^^^^^ constant
                 ^^^^^^^ constant
                         ^^^^^^ number
> --- a/src/main.rs
  ^^^^^^^^^^^^^^^^^ diff.minus
> +++ b/src/main.rs
  ^^^^^^^^^^^^^^^^^ diff.plus
> @@ -1,4 +1,5 @@ fn main() {
  ^^^^^^^^^^^^^^^^^^^^^^^^^^^ attribute
>  fn main() {
   ^^ -
> -    println!("old");
  ^^^^^^^^^^^^^^^^^^^^^ diff.minus
> +    println!("new");
  ^^^^^^^^^^^^^^^^^^^^^ diff.plus
>  }
> \ No newline at end of file
  ^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment

# A line taken away that started with `--` begins with `---`, and one
# added that started with `++` with `+++`; inside a hunk they are lines,
# not files' names
> @@ -1,3 +1,3 @@
>  select 1;
> --- old comment
  ^^^^^^^^^^^^^^^ diff.minus
> +++ new counter
  ^^^^^^^^^^^^^^^ diff.plus
>  select 2;

# A diff from `diff -ru`: the second file's names follow the first's hunk
> --- a/one.txt	2026-11-07 10:00:00
  ^^^^^^^^^^^^^ diff.minus
> +++ b/one.txt	2026-11-07 10:01:00
  ^^^^^^^^^^^^^ diff.plus
> @@ -1 +1 @@
  ^^^^^^^^^^^ attribute
> -a
  ^^ diff.minus
> +b
  ^^ diff.plus
> --- a/two.txt	2026-11-07 10:00:00
  ^^^^^^^^^^^^^ diff.minus
> +++ b/two.txt	2026-11-07 10:01:00
  ^^^^^^^^^^^^^ diff.plus
> @@ -1 +1 @@
> -c
  ^^ diff.minus

# A file added and one renamed: the lines that say so are labels
> diff --git a/new.txt b/new.txt
> new file mode 100644
  ^^^^^^^^^^^^^ label
                ^^^^^^ number
> diff --git a/old.txt b/renamed.txt
> similarity index 90%
                   ^^^ number
> rename from old.txt
  ^^^^^^^^^^^^^^^^^^^ label

# The hunk `git add -p` hands over to edit, with its `#` help
> # Manual hunk edit mode -- see bottom for a quick guide.
  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment
> @@ -3,7 +3,7 @@
> -old
  ^^^^ diff.minus
> +new
  ^^^^ diff.plus
> # ---
  ^^^^^ comment
